<Window
    x:Class="Mvvm.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:Mvvm.Views"
    Title="{Binding Title}"
    Width="1100"
    Height="640"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource MainBackground}"
    Loaded="MainWindow_Loaded"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="av">



    <Grid Height="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="100*" />
            <RowDefinition
                Height="43"
                MinHeight="43"
                MaxHeight="43" />
        </Grid.RowDefinitions>

        <materialDesign:ColorZone
            Padding="10"
            VerticalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp4"
            Background="#FF009BD1"
            ClipToBounds="False"
            CornerRadius="10"
            Mode="PrimaryDark">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Width="150"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Title}" />
            </StackPanel>
        </materialDesign:ColorZone>
        <!--  버튼  -->

        <Button
            Grid.Row="0"
            Width="80"
            Height="60"
            Margin="0,0,90,0"
            HorizontalAlignment="Right"
            Command="{Binding NavigateToParameterWindowCommand}"
            Style="{StaticResource NavigateToParameterWindow}">
            <StackPanel>
                <TextBlock
                    Width="80"
                    Margin="5,40,0,0"
                    FontSize="9"
                    Foreground="White"
                    Text="모드버스 데이터" />
            </StackPanel>
        </Button>

        <Button
            Grid.Row="0"
            Width="80"
            Height="60"
            Margin="0,0,170,0"
            HorizontalAlignment="Right"
            Command="{Binding NavigateToModbusDataViewPageCommand}"
            Style="{StaticResource ModbusDataButton}">
            <StackPanel>
                <TextBlock
                    Width="80"
                    Margin="20,40,0,0"
                    FontSize="9"
                    Foreground="White"
                    Text="차트 보기" />
            </StackPanel>
        </Button>

        <ContentControl Grid.Row="1" prism:RegionManager.RegionName="ContentRegion" />

        <Button
            Width="35"
            Height="35"
            Margin="0,0,380,-2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="{x:Null}"
            BorderBrush="{Binding IconColor}"
            Command="{Binding PortConnectButton}"
            Foreground="{Binding IconColor}"
            Style="{StaticResource MaterialDesignFloatingActionLightButton}"
            ToolTip="MaterialDesignFloatingActionLightButton">
            <Path Data="{StaticResource ConnectPlugIcon}" Fill="{Binding IconColor}" />
        </Button>


        <ComboBox
            x:Name="PortComboBox"
            Width="120"
            Height="40"
            Margin="0,0,250,0"
            Padding="0,0,10,0"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Center"
            materialDesign:HintAssist.Hint="포트 연결"
            materialDesign:TextFieldAssist.HasClearButton="True"
            BorderBrush="#B2FFFFFF"
            Foreground="Black"
            ItemsSource="{Binding ShortStringList}"
            SelectedItem="{Binding SelectPort}"
            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
        <materialDesign:DrawerHost
            x:Name="DrawerHost"
            Grid.RowSpan="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            av:IsHidden="True"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            BottomDrawerBackground="{DynamicResource SecondaryHueLightBrush}"
            BottomDrawerCornerRadius="20 20 0 0">
            <materialDesign:DrawerHost.Style>
                <Style BasedOn="{StaticResource {x:Type materialDesign:DrawerHost}}" TargetType="{x:Type materialDesign:DrawerHost}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=BackgroundToggle}" Value="True">
                            <Setter Property="OverlayBackground" Value="{DynamicResource PrimaryHueMidBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:DrawerHost.Style>

            <materialDesign:DrawerHost.RightDrawerContent>
                <StackPanel Margin="0,89,0,16">
                    <TextBlock
                        Margin="4,20,4,4"
                        HorizontalAlignment="Center"
                        Text="모드버스 설정" />

                    <Button
                        Margin="4,20,4,4"
                        HorizontalAlignment="Center"
                        Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        Content="CLOSE THIS"
                        Style="{StaticResource MaterialDesignFlatButton}" />

                    <Button
                        Margin="4,20,4,4"
                        HorizontalAlignment="Center"
                        Command="{Binding NavigateToSettingWindowCommand}"
                        Content="Setting"
                        Style="{StaticResource MaterialDesignRaisedLightButton}"
                        ToolTip="통신 설정" />

                </StackPanel>
            </materialDesign:DrawerHost.RightDrawerContent>

            <Grid
                Margin="0,18,70,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="4,4,4,4"
                    Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                    CommandParameter="{x:Static Dock.Right}"
                    Content="{materialDesign:PackIcon Kind=MenuClose}" />

            </Grid>
        </materialDesign:DrawerHost>
        <ContentControl Grid.Row="2" prism:RegionManager.RegionName="BottmContentRegion" />


        <materialDesign:Snackbar
            x:Name="SnackbarOne"
            Grid.Row="1"
            Width="200"
            Height="38"
            Margin="0,0,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsActive="True"
            MessageQueue="{Binding BottomMessageQueue}">
            <materialDesign:Snackbar.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterX="0.5" CenterY="0.5" />
                            <SkewTransform CenterX="0.5" CenterY="0.5" />
                            <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5" />
                            <TranslateTransform />
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <LinearGradientBrush.Transform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform Angle="0" />
                            <TranslateTransform />
                        </TransformGroup>
                    </LinearGradientBrush.Transform>
                    <GradientStop Color="#FF009AD2" />
                    <GradientStop Offset="1" Color="#FFB46FFE" />
                    <GradientStop Offset="0.53" Color="#FF6C85E6" />
                </LinearGradientBrush>
            </materialDesign:Snackbar.Background>
        </materialDesign:Snackbar>
        <Button
            Grid.Row="0"
            Width="80"
            Height="60"
            Margin="140,0,0,0"
            HorizontalAlignment="Left"
            Command="{Binding NavigateToHomePageCommand}"
            Style="{StaticResource MainHomePageButton}">
            <StackPanel>
                <TextBlock
                    Width="80"
                    Margin="0,40,0,0"
                    Padding="34,0,0,0"
                    HorizontalAlignment="Left"
                    FontSize="10"
                    Foreground="White"
                    Text="홈" />
            </StackPanel>
        </Button>
        <Button
            Grid.Row="0"
            Width="80"
            Height="60"
            Margin="230,0,0,0"
            HorizontalAlignment="Left"
            Command="{Binding NavigateToHomePageCommand}"
            Style="{StaticResource CustomPageButton}">
            <StackPanel>
                <TextBlock
                    Width="80"
                    Margin="0,40,0,0"
                    Padding="28,0,0,0"
                    HorizontalAlignment="Left"
                    FontSize="10"
                    Foreground="White"
                    Text="가변" />
            </StackPanel>
        </Button>
    </Grid>

</Window>
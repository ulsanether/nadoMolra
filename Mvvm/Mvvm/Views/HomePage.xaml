<UserControl
    x:Class="Mvvm.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    mc:Ignorable="av">




    <Grid Width="1000" Height="642">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200*" />
            <ColumnDefinition Width="400*" />

            <ColumnDefinition Width="170" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <Grid
            Grid.RowSpan="2"
            Width="NaN"
            HorizontalAlignment="Left">


            <DockPanel
                Width="566"
                HorizontalAlignment="Center"
                LastChildFill="False">
                <StackPanel>
                    <ListBox
                        x:Name="LeftBoundListBox"
                        Width="566"
                        Height="642"
                        HorizontalAlignment="Left"
                        dd:DragDrop.CanDragWithMouseRightButton="True"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.DropTargetAdornerBrush="Coral"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                        ItemsSource="{Binding Borders2}" />
                </StackPanel>
            </DockPanel>


        </Grid>


        <Grid
            Grid.RowSpan="2"
            Grid.Column="2"
            av:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin"
            Background="#FFFF4C4C">
            <ScrollViewer>
                <DockPanel
                    Width="120"
                    Height="642"
                    av:LayoutOverrides="TopPosition, BottomPosition"
                    LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Text="Modbus Data  2" />
                    <ListView
                        x:Name="ModbusDataName"
                        Width="119"
                        Height="Auto"
                        dd:DragDrop.CanDragWithMouseRightButton="True"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                        ItemsSource="{Binding Borders1}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </DockPanel>
            </ScrollViewer>
        </Grid>
        <Grid
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="NaN"
            HorizontalAlignment="Left">


            <DockPanel
                Width="566"
                HorizontalAlignment="Center"
                LastChildFill="False">
                <StackPanel>
                    <ListBox
                        x:Name="LeftBoundListBox1"
                        Width="566"
                        Height="642"
                        HorizontalAlignment="Left"
                        dd:DragDrop.CanDragWithMouseRightButton="True"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.DropTargetAdornerBrush="Coral"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                        ItemsSource="{Binding Borders3}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Width="560" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                </StackPanel>
            </DockPanel>


        </Grid>

    </Grid>
</UserControl>

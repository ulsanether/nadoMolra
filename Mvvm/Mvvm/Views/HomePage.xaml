<UserControl
    x:Class="Mvvm.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    mc:Ignorable="av">




    <Grid
        Width="1000"
        Height="642"
        Margin="5,0,0,0">
        <Grid.Background>
            <ImageBrush />
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200*" />
            <ColumnDefinition Width="229*" />
            <ColumnDefinition Width="142" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="93*" />
            <RowDefinition Height="313*" />
            <RowDefinition Height="236*" />
        </Grid.RowDefinitions>



        <Border
            Margin="5,10,5,10"
            BorderBrush="#FFC0A9BA"
            BorderThickness="1"
            CornerRadius="6"
            IsEnabled="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterX="0.5" CenterY="0.5" />
                            <SkewTransform CenterX="0.5" CenterY="0.5" />
                            <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5" />
                            <TranslateTransform />
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF4AB3D8" />
                    <GradientStop Offset="1" Color="#FFC793F7" />
                    <GradientStop Offset="0.438" Color="#FF88A2E7" />
                    <GradientStop Offset="0.629" Color="#FF88A2E7" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>

                <DropShadowEffect
                    BlurRadius="5"
                    Direction="300"
                    Opacity="0.195"
                    RenderingBias="Performance" />
            </Border.Effect>

        </Border>

        <Grid
            Grid.Row="1"
            Margin="4,0,-4,0"
            av:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin">


            <DockPanel
                Width="400"
                HorizontalAlignment="Left"
                LastChildFill="False">
                <TextBlock
                    Width="400"
                    Height="17.29"
                    DockPanel.Dock="Top"
                    FontSize="13"
                    Foreground="{DynamicResource MainFontColor}"><Run Language="ko-kr" Text="Slider Window" /></TextBlock>
                <StackPanel Width="400" Background="#FFFF8E8E">

                    <ListBox
                        x:Name="LeftBoundListBox"
                        Width="400"
                        Height="500"
                        HorizontalAlignment="Center"
                        dd:DragDrop.CanDragWithMouseRightButton="True"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.DropTargetAdornerBrush="Coral"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                        ItemsSource="{Binding Borders2}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel
                                    Width="400"
                                    Height="329"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>


                </StackPanel>
            </DockPanel>


        </Grid>
        <Grid Grid.Row="2" Margin="4,0,-4,0">


            <DockPanel
                Width="400"
                HorizontalAlignment="Left"
                LastChildFill="False">
                <TextBlock
                    Height="17"
                    DockPanel.Dock="Top"
                    FontSize="13"
                    Foreground="{DynamicResource MainFontColor}"
                    Text="MODBUS LIST 1-2" />
                <StackPanel Width="400" Background="Black">
                    <ListBox
                        x:Name="LeftBoundListBox2"
                        Width="400"
                        Height="500"
                        dd:DragDrop.CanDragWithMouseRightButton="True"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.DropTargetAdornerBrush="Coral"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                        ItemsSource="{Binding Borders4}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Width="400" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </DockPanel>


        </Grid>


        <Grid
            Grid.RowSpan="3"
            Grid.Column="2"
            av:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin">
            <DockPanel LastChildFill="False">

                <TextBlock
                    DockPanel.Dock="Top"
                    FontSize="13"
                    Foreground="{DynamicResource MainFontColor}"
                    Text="MODBUS LIST" />
                <ListView
                    x:Name="ModbusDataName"
                    Width="140"
                    Height="Auto"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    dd:DragDrop.CanDragWithMouseRightButton="True"
                    dd:DragDrop.DropHandler="{Binding}"
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True"
                    dd:DragDrop.UseDefaultEffectDataTemplate="True"
                    FontSize="14"
                    ItemsSource="{Binding Borders1}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </DockPanel>
        </Grid>
        <GridSplitter
            Grid.Column="2"
            Width="2"
            Height="0"
            Margin="44,40,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            av:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin"
            Background="{StaticResource ProgressColor}"
            Foreground="{StaticResource ProgressColor}" />

        <!--  linear progress bars (the default style  -->

        <Grid
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="NaN">


            <DockPanel
                Width="430"
                Height="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                LastChildFill="False">
                <TextBlock
                    Height="17.29"
                    DockPanel.Dock="Top"
                    FontSize="13"
                    Foreground="{DynamicResource MainFontColor}"
                    Text="Window  " />
                <StackPanel Width="430" Background="#FFA02525">
                    <ListBox
                        x:Name="LeftBoundListBox1"
                        Width="430"
                        Height="479"
                        HorizontalAlignment="Left"
                        dd:DragDrop.CanDragWithMouseRightButton="True"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.DropTargetAdornerBrush="Coral"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                        ItemsSource="{Binding Borders3}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Width="400" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                </StackPanel>
            </DockPanel>


        </Grid>
        <Label
            x:Name="SubTitleName"
            Width="168"
            Height="25"
            Margin="32,15,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            av:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin"
            Content="{Binding SubTitleName}"
            FontFamily="Yu Gothic UI Semibold"
            FontSize="13"
            Foreground="White">
            <Label.Background>
                <ImageBrush />
            </Label.Background>
        </Label>
        <Label
            x:Name="SubTitleNote"
            Height="8"
            Margin="32,38,72,0"
            VerticalAlignment="Top"
            av:LayoutOverrides="HorizontalAlignment, LeftMargin, RightMargin, TopMargin, BottomMargin"
            Content="{Binding SubTitleNote}"
            FontFamily="Yu Gothic UI Semibold"
            Foreground="White">
            <Label.Background>
                <SolidColorBrush Opacity="0" />
            </Label.Background>
        </Label>
        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Margin="15,0,15,0"
            Background="#FF0061FF">
            <DockPanel
                Width="428"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                LastChildFill="False">
                <TextBlock
                    Width="400"
                    Height="17.29"
                    Margin="5,0,0,0"
                    DockPanel.Dock="Top"
                    FontSize="13"
                    Foreground="{DynamicResource MainFontColor}"
                    Text="MODBUS LIST 2-2" />
                <StackPanel Width="430">
                    <ListBox
                        x:Name="LeftBoundListBox3"
                        Width="420"
                        Height="500"
                        dd:DragDrop.CanDragWithMouseRightButton="True"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.DropTargetAdornerBrush="Coral"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                        ItemsSource="{Binding Borders5}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Width="400" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Grid>

    </Grid>
</UserControl>

<UserControl
    x:Class="Mvvm.Views.MainBottomBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:Mvvm.ViewModels"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FFC8C8C8">

    <Grid Margin="5">

        <StackPanel
            Margin="55,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="White"
            Orientation="Horizontal">
            <!--  Port 상태 표시  -->
            <Border
                Margin="2"
                Padding="5,2"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="상태: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{Binding IsConnected}"
                        Text="{Binding PortState, UpdateSourceTrigger=PropertyChanged}" />
                    <materialDesign:PackIcon Margin="30,0,0,0" Kind="{Binding IsConnected, Converter={StaticResource BooleanToIconConverter}}" />
                </StackPanel>
            </Border>

            <!--  Port 이름 표시  -->
            <Border
                Margin="2"
                Padding="5,2"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="포트: " />
                    <TextBlock VerticalAlignment="Center" Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <!--  Baud Rate 표시  -->
            <Border
                x:Name="ClickAdvancedMode"
                Margin="2"
                Padding="5,2"
                BorderBrush="Gray"
                BorderThickness="1">

                <Border.InputBindings>
                    <MouseBinding Command="{Binding AdvancedModeCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>

                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="전송속도: " />
                    <TextBlock VerticalAlignment="Center" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>


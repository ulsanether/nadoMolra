<UserControl
    x:Class="Mvvm.Views.ModbusDataViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mvvm.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Mvvm.ViewModels"
    d:DesignHeight="520"
    d:DesignWidth="800"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <TabControl>
            <TabItem Header="실시간 차트">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  컨트롤 패널  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">
                        <ToggleButton
                            Width="100"
                            Margin="5"
                            Content="실시간 업데이트"
                            IsChecked="{Binding IsRealTimeUpdate}" />

                        <Button
                            Width="80"
                            Margin="5"
                            Command="{Binding ResetChartCommand}"
                            Content="초기화" />

                        <ComboBox
                            Width="200"
                            Margin="5"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding AvailableParameters}"
                            SelectedItem="{Binding SelectedParameter}" />

                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{Binding CurrentValue, StringFormat=현재값: {0:F2}}" />
                    </StackPanel>

                    <!--  차트  -->
                    <ScottPlot:WpfPlot
                        x:Name="RealTimeChart"
                        Grid.Row="1"
                        Margin="5" />
                </Grid>
            </TabItem>

            <TabItem Header="Set Point Table">
                <Grid>
                    <DataGrid
                        Margin="5"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding AvailableParameters}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Address}"
                                Header="주소" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Label}"
                                Header="레이블" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Description}"
                                Header="설명" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding DefaultActual, StringFormat=F2}"
                                Header="현재값" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding ModbusUnit}"
                                Header="단위" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="EtcData">
                <Grid Background="#FFE5E5E5" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<!--  ModbusDataViewPage.xaml  -->
<UserControl
    x:Class="Mvvm.Views.ModbusDataViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mvvm.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Mvvm.ViewModels"
    d:DesignHeight="520"
    d:DesignWidth="800"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <TabControl>
            <!--  실시간 차트 탭  -->
            <TabItem Header="실시간 차트">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  컨트롤 패널  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">
                        <ToggleButton
                            Width="100"
                            Margin="5"
                            Content="실시간 업데이트"
                            IsChecked="{Binding IsRealTimeUpdate}" />

                        <Button
                            Width="80"
                            Margin="5"
                            Command="{Binding ResetChartCommand}"
                            Content="초기화" />

                        <ComboBox
                            Width="200"
                            Margin="5"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding AvailableParameters}"
                            SelectedItem="{Binding SelectedParameter}" />

                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{Binding CurrentValue, StringFormat=현재값: {0:F2}}" />

                        <ComboBox
                            Width="120"
                            Margin="5"
                            ItemsSource="{Binding ChartTypes}"
                            SelectedItem="{Binding SelectedChartType}" />

                        <CheckBox
                            Margin="5"
                            VerticalAlignment="Center"
                            Content="자동 스케일"
                            IsChecked="{Binding AutoScale}" />
                    </StackPanel>

                    <!--  차트  -->
                    <ScottPlot:WpfPlot
                        x:Name="RealTimeChart"
                        Grid.Row="1"
                        Margin="5" />
                </Grid>
            </TabItem>

            <!--  데이터 테이블 탭  -->
            <TabItem Header="Set Point Table">
                <Grid>
                    <DataGrid
                        Margin="5"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding AvailableParameters}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Address}"
                                Header="주소" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Label}"
                                Header="레이블" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Description}"
                                Header="설명" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding DefaultActual, StringFormat=F2}"
                                Header="현재값" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding ModbusUnit}"
                                Header="단위" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!--  통신 상태 탭  -->
            <TabItem Header="통신 상태">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  통신 상태 표시  -->
                    <GroupBox Margin="0,0,0,10" Header="통신 상태">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Margin="5" Text="성공률:" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5"
                                Text="{Binding Statistics.SuccessRate, StringFormat={}{0:F2}%}" />

                            <TextBlock
                                Grid.Column="2"
                                Margin="5"
                                Text="오류 수:" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="5"
                                Text="{Binding Statistics.ErrorCount}" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="5"
                                Text="마지막 성공:" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5"
                                Text="{Binding Statistics.LastSuccessfulRead}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="5"
                                Text="마지막 오류:" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="5"
                                Text="{Binding Statistics.LastError}" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="5"
                                Text="재연결 성공률:" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="5"
                                Text="{Binding Statistics.ReconnectSuccessRate, StringFormat={}{0:F2}%}" />
                        </Grid>
                    </GroupBox>

                    <!--  차트 설정  -->
                    <GroupBox
                        Grid.Row="1"
                        Margin="0,0,0,10"
                        Header="데이터 관리">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="120"
                                Margin="5"
                                Command="{Binding ExportDataCommand}"
                                Content="데이터 내보내기" />

                            <Button
                                Width="100"
                                Margin="5"
                                Command="{Binding ResetStatisticsCommand}"
                                Content="통계 초기화" />
                        </StackPanel>
                    </GroupBox>

                    <!--  통신 로그  -->
                    <GroupBox Grid.Row="2" Header="통신 로그">
                        <ListView ItemsSource="{Binding CommunicationLog}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn
                                        Width="150"
                                        DisplayMemberBinding="{Binding Timestamp}"
                                        Header="시간" />
                                    <GridViewColumn
                                        Width="200"
                                        DisplayMemberBinding="{Binding Event}"
                                        Header="이벤트" />
                                    <GridViewColumn
                                        Width="300"
                                        DisplayMemberBinding="{Binding Details}"
                                        Header="상세" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>



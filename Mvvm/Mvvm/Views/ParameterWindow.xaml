<UserControl
    x:Class="Mvvm.Views.ParameterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mvvm.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Mvvm;component/Dictionaries/Styles.xaml" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  상단 제어 패널  -->
        <Grid x:Name="AdvencedView" Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                Grid.Column="5"
                Command="{Binding ToggleParameterUpdateCommand}"
                Content="자동 갱신"
                Cursor="Hand"
                IsChecked="{Binding IsParameterUpdateActive}" />

            <!--  시작 주소  -->
            <TextBlock
                Grid.Column="0"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="시작 주소:" />
            <TextBox
                x:Name="StartAddressTextBox"
                Grid.Column="1"
                Margin="0,0,10,0"
                materialDesign:HintAssist.Hint="시작"
                Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" />
            <!--  끝 주소  -->
            <TextBlock
                Grid.Column="2"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="끝 주소:" />
            <TextBox
                x:Name="EndAddressTextBox"
                Grid.Column="3"
                Margin="0,0,10,0"
                materialDesign:HintAssist.Hint="끝"
                Text="{Binding EndAddress, UpdateSourceTrigger=PropertyChanged}" />



            <!--  생성 버튼  -->
            <Button
                Grid.Column="4"
                Margin="0,0,10,0"
                Command="{Binding GenerateParametersCommand}"
                Content="생성" />




            <!--  표시 방식 선택  -->
            <StackPanel
                Grid.Column="6"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <RadioButton
                    Margin="0,0,10,0"
                    Content="리스트 형식"
                    IsChecked="{Binding IsListView}" />
                <RadioButton Content="카드 형식" IsChecked="{Binding IsCardView}" />
            </StackPanel>
        </Grid>


        <!--  파라미터 표시 영역  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ItemsControl
                x:Name="ParameterItemsControl"
                ItemTemplateSelector="{StaticResource ParameterTemplateSelector}"
                ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Background="LightGray" IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

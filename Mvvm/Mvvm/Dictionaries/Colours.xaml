<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



    <!--  Main Background color  -->

    <SolidColorBrush x:Key="MainBackground" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFC0A9BA" />
    <SolidColorBrush x:Key="MainFontColor" Color="#FF009BD1" />
    <SolidColorBrush x:Key="SubOneFontColor" Color="White" />
    <SolidColorBrush x:Key="SubTwoFontColor" Color="#FF009BD1" />
    <SolidColorBrush x:Key="ProgressColor" Color="#FFB46FFE" />

    <SolidColorBrush x:Key="GBlue" Color="#FF4AB3D8" />

    <!--  MainBar Button color  -->
    <SolidColorBrush x:Key="MainButtonFontColor" Color="#FF009BD1" />
    <SolidColorBrush x:Key="MainButtonOverOneColor" Color="#FF6EC6FF" />
    <SolidColorBrush x:Key="MainButtonOverColor" Color="#FF6C85E6" />
    <SolidColorBrush x:Key="MainButtonClickColor" Color="#FFB46FFE" />
    <SolidColorBrush x:Key="MainButtonPath" Color="#FFF2F2F2" />


    <!--  App Accent Color  -->

    <SolidColorBrush x:Key="AccentBackground" Color="#FF009BD1" />
    <SolidColorBrush x:Key="AccentOver" Color="#4FBBDF" />
    <SolidColorBrush x:Key="AccentClick" Color="#FF505050" />


    <!--  App Border Bar  -->
    <SolidColorBrush x:Key="ToolBarMenu" Color="#FF3C3C3C" />




    <!--  Task view Background  -->



</ResourceDictionary>
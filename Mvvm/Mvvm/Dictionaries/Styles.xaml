<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mvvm.Converters"
    xmlns:local="clr-namespace:Mvvm.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">



    <converters:CommandParameterTypeConverter x:Key="CommandParameterTypeConverter" />

    <!--  보더1 스타일  -->
    <Style x:Key="DefaultBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#F2F2F2" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#C0A9BA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="IsEnabled" Value="True" />
    </Style>

    <Style x:Key="DefaultBorderLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Yu Gothic UI Semibold" />
        <Setter Property="Foreground" Value="{StaticResource MainFontColor}" />
    </Style>

    <!--  ContentControl을 위한 ControlTemplate  -->
    <ControlTemplate x:Key="BorderWithLabelTemplate" TargetType="{x:Type ContentControl}">
        <Border Style="{StaticResource DefaultBorderStyle}">
            <Label Content="{TemplateBinding Content}" Style="{StaticResource DefaultBorderLabelStyle}" />
        </Border>
    </ControlTemplate>



    <!--  보더 1 스타일 왼위의 보더  -->
    <Style
        x:Key="Borders1Style"
        BasedOn="{StaticResource DefaultBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="50" />
    </Style>




    <!--  보더 2 스타일 아직 없음  -->
    <Style
        x:Key="Borders2Style"
        BasedOn="{StaticResource DefaultBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="200" />
    </Style>




    <!--  보더 3 스타일 아직 없음  -->
    <!--  보더 3 스타일 수정  -->
    <Style
        x:Key="Borders3Style"
        BasedOn="{StaticResource DefaultBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="150" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#F9F9F9" />
                    <GradientStop Offset="1" Color="#E0E0E0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="3"
                    Opacity="0.2"
                    ShadowDepth="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Border3 버튼 스타일  -->
    <Style x:Key="Border3ButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#4A85D8" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3C6EB5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#2C5594" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  보더 4 스타일 아직 없ㅇ므  -->
    <Style
        x:Key="Borders4Style"
        BasedOn="{StaticResource DefaultBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="30" />
    </Style>

    <!--  보더 5 스타일 아직 없ㅇ므  -->
    <Style
        x:Key="Borders5Style"
        BasedOn="{StaticResource DefaultBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="50" />
    </Style>



    <!--  바텀 페이지 아이콘  -->

    <Style x:Key="AlertButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Path
                            x:Name="IconPath"
                            Width="30"
                            Height="30"
                            Data="{StaticResource AlertIcon}"
                            Fill="{Binding IconColor}" />
                        <TextBlock
                            x:Name="AlertCount"
                            Margin="0,0,5,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            FontWeight="Bold"
                            Foreground="Red"
                            Text="{Binding AlertCount}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasAlert}" Value="True">
                            <Setter TargetName="IconPath" Property="Fill" Value="Red" />
                            <Setter TargetName="IconPath" Property="Data" Value="{StaticResource AlertFillIcon}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>





    <!--  메인 페이지 아이콘들  -->

    <Style x:Key="MainHomePageButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource MainButtonFontColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="White"
                        CornerRadius="1">
                        <Grid>
                            <Path
                                Width="20"
                                Height="25"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                Data="{StaticResource HomeIcon}"
                                Fill="Black"
                                Opacity="0.2"
                                Stretch="Fill" />
                            <Path
                                x:Name="PathIcon"
                                Width="20"
                                Height="25"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                Data="{StaticResource HomeIcon}"
                                Fill="{StaticResource MainButtonPath}"
                                Stretch="Fill" />

                            <ContentPresenter
                                x:Name="MyContentPresenter"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MainButtonOverOneColor}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="PathIcon" Property="Fill" Value="Transparent" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource MainButtonClickColor}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavigateToParameterWindow" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource MainButtonFontColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="White"
                        CornerRadius="1">
                        <Grid>
                            <Path
                                Width="20"
                                Height="25"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                Data="{StaticResource ParameterOpenIcon}"
                                Fill="Black"
                                Opacity="0.2"
                                Stretch="Fill" />
                            <Path
                                x:Name="PathIcon"
                                Width="20"
                                Height="25"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                Data="{StaticResource ParameterOpenIcon}"
                                Fill="{StaticResource MainButtonPath}"
                                Stretch="Fill" />

                            <ContentPresenter
                                x:Name="MyContentPresenter"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MainButtonOverOneColor}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="PathIcon" Property="Fill" Value="Transparent" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource MainButtonClickColor}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModbusDataButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource MainButtonFontColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="White"
                        CornerRadius="1">
                        <Grid>
                            <Path
                                Width="20"
                                Height="25"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                Data="{StaticResource ModbusDataOpenIcon}"
                                Fill="Black"
                                Opacity="0.2"
                                Stretch="Fill" />
                            <Path
                                x:Name="PathIcon"
                                Width="20"
                                Height="25"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center"
                                Data="{StaticResource ModbusDataOpenIcon}"
                                Fill="{StaticResource MainButtonPath}"
                                Stretch="Fill" />

                            <ContentPresenter
                                x:Name="MyContentPresenter"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MainButtonOverOneColor}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="PathIcon" Property="Fill" Value="Transparent" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource MainButtonClickColor}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  보더 1 스타일  -->







    <!--  보더 2 스타일  -->







    <!--  공통 스타일  -->
    <Style x:Key="ModbusValueTextBlock" TargetType="TextBlock">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsValueChanged}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(TextBlock.Background).(SolidColorBrush.Color)"
                                From="Yellow"
                                To="Transparent"
                                Duration="0:0:1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  리스트 형식 템플릿  -->
    <DataTemplate x:Key="ListTemplate">
        <materialDesign:Card Margin="5" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="20" />
                    <!--  Index  -->
                    <ColumnDefinition Width="180" />
                    <!--  Description  -->

                    <ColumnDefinition Width="30" />
                    <!--  Unit  -->

                    <ColumnDefinition Width="80" />
                    <!--  Default  -->

                    <ColumnDefinition Width="100" />
                    <!--  Current Value  -->

                    <ColumnDefinition Width="80" />
                    <!--  Setting Value  -->

                    <ColumnDefinition Width="50" />
                    <!--  Symbols  -->

                    <ColumnDefinition Width="140" />
                    <!--  Range  -->

                    <ColumnDefinition Width="Auto" />
                    <!--  Save Button  -->
                </Grid.ColumnDefinitions>

                <!--  인덱스  -->
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding Index}" />

                <!--  설명  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />

                <!--  단위  -->
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding Unit}" />

                <!--  기본값  -->
                <TextBlock
                    Grid.Column="3"
                    Margin="0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding DefaultValue, StringFormat={}{0:F1}}" />

                <!--  현재값  -->
                <TextBlock
                    Grid.Column="4"
                    Margin="0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding DefaultActual, StringFormat={}{0:F1}}" />

                <!--  설정값 입력  -->
                <TextBox
                    Grid.Column="5"
                    Width="50"
                    Margin="6,0"
                    VerticalAlignment="Center"
                    Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Symbols  -->
                <TextBlock
                    Grid.Column="6"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Text="{Binding Symbols}" />

                <!--  Range  -->
                <TextBlock
                    Grid.Column="7"
                    Margin="5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding NormalRange}" />
                <Button
                    Grid.Column="8"
                    Width="100"
                    Margin="5,0"
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.WriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Converter={StaticResource CommandParameterTypeConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Kind="ContentSave" />
                        <TextBlock
                            Width="0"
                            MaxWidth="0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="Black"
                            Text="{Binding Index}" />
                    </StackPanel>
                </Button>


            </Grid>
        </materialDesign:Card>
    </DataTemplate>

    <!--  카드 형식 템플릿  -->
    <DataTemplate x:Key="CardTemplate">
        <materialDesign:Card
            Width="300"
            Margin="5"
            Padding="8"
            Background="{DynamicResource MaterialDesignBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  헤더 (인덱스 + 설명)  -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <TextBlock
                        Width="40"
                        Margin="0,4"
                        DockPanel.Dock="Left"
                        FontWeight="Bold"
                        Text="{Binding Index}" />
                    <TextBlock
                        Width="0"
                        MaxWidth="100"
                        Margin="0,0,0,0"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                </DockPanel>

                <!--  단위  -->
                <DockPanel Grid.Row="1" Margin="0,8">
                    <TextBlock Text="단위: " />
                    <TextBlock Margin="8,0,0,0" Text="{Binding Unit}" />
                </DockPanel>

                <!--  기본값  -->
                <DockPanel Grid.Row="2" Margin="0,8">
                    <TextBlock Text="기본값: " />
                    <TextBlock Margin="8,0,0,0" Text="{Binding DefaultValue, StringFormat={}{0:F1}}" />
                </DockPanel>

                <!--  현재값 + 설정값  -->
                <Grid Grid.Row="3" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  현재값  -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="현재값" />
                        <TextBlock
                            FontSize="20"
                            Style="{StaticResource ModbusValueTextBlock}"
                            Text="{Binding DefaultActual, StringFormat={}{0:F1}}" />
                    </StackPanel>

                    <!--  설정값  -->
                    <TextBox
                        Grid.Column="1"
                        Width="100"
                        Margin="6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--  Symbols  -->
                <DockPanel Grid.Row="4" Margin="0,8">
                    <TextBlock Text="Symbols: " />
                    <TextBlock Margin="8,0,0,0" Text="{Binding Symbols}" />
                </DockPanel>

                <!--  Range  -->
                <DockPanel Grid.Row="5" Margin="0,8">
                    <TextBlock Text="Range: " />
                    <TextBlock Margin="8,0,0,0" Text="{Binding NormalRange}" />
                </DockPanel>
                <Button
                    Grid.Row="6"
                    Width="100"
                    Margin="5,0"
                    Command="{Binding DataContext.WriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Converter={StaticResource CommandParameterTypeConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Kind="ContentSave" />
                        <TextBlock
                            Width="0"
                            MaxWidth="0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="Transparent"
                            Text="{Binding Index}" />
                    </StackPanel>
                </Button>



            </Grid>
        </materialDesign:Card>
    </DataTemplate>

    <!--  DataTemplateSelector 등록  -->
    <local:ParameterTemplateSelector
        x:Key="ParameterTemplateSelector"
        CardTemplate="{StaticResource CardTemplate}"
        ListTemplate="{StaticResource ListTemplate}" />

</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Mvvm.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- 공통 스타일 -->
    <Style x:Key="ModbusValueTextBlock" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsValueChanged}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation 
                                Storyboard.TargetProperty="(TextBlock.Background).(SolidColorBrush.Color)"
                                From="Yellow" To="Transparent" Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  리스트 형식 템플릿  -->
    <DataTemplate x:Key="ListTemplate">
        <materialDesign:Card Margin="5" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 레지스터 이름 -->
                <TextBlock Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding Label}"
                    ToolTip="{Binding Description}"/>

                <!-- 현재값 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock 
                        Style="{StaticResource ModbusValueTextBlock}"
                        VerticalAlignment="Center"
                        Text="{Binding DefaultActual, StringFormat={}{0:F2}}" />
                    <TextBlock 
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding ModbusUnit}" />
                </StackPanel>

                <!-- 설정값 입력 -->
                <TextBox Grid.Column="2" 
                    Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="설정값"/>

                <!-- 상태 표시 -->
                <materialDesign:PackIcon Grid.Column="3"
                    Kind="{Binding StatusIcon}"
                    ToolTip="{Binding StatusMessage}"
                    Foreground="{Binding StatusColor}"/>

                <!-- 적용 버튼 -->
                <Button Grid.Column="4"
                    Margin="5,0"
                    Command="{Binding DataContext.WriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                    <materialDesign:PackIcon Kind="ContentSave"/>
                </Button>

                <!-- 모니터링 체크박스 -->
                <CheckBox Grid.Column="5"
                    Margin="5,0,0,0"
                    Content="모니터링"
                    IsChecked="{Binding IsMonitoring, Mode=TwoWay}" />
            </Grid>
        </materialDesign:Card>
    </DataTemplate>

    <!--  카드 형식 템플릿  -->
    <DataTemplate x:Key="CardTemplate">
        <materialDesign:Card
            Width="250"
            Margin="5"
            Padding="8"
            Background="{DynamicResource MaterialDesignBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <materialDesign:PackIcon 
                        Kind="{Binding StatusIcon}"
                        Foreground="{Binding StatusColor}"
                        ToolTip="{Binding StatusMessage}"
                        Width="24" Height="24"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Margin="8,4"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding Label}" 
                        ToolTip="{Binding Description}"/>
                </DockPanel>

                <!-- 현재값 표시 -->
                <StackPanel Grid.Row="1" Margin="0,8">
                    <TextBlock Text="현재값" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                    <DockPanel LastChildFill="True">
                        <TextBlock 
                            Style="{StaticResource ModbusValueTextBlock}"
                            Text="{Binding DefaultActual, StringFormat={}{0:F2}}"
                            FontSize="24"/>
                        <TextBlock 
                            Text="{Binding ModbusUnit}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"/>
                    </DockPanel>
                </StackPanel>

                <!-- 설정값 입력 -->
                <StackPanel Grid.Row="2" Margin="0,8">
                    <TextBox
                        Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="설정값 입력"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>

                <!-- 컨트롤 -->
                <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                    <CheckBox
                        DockPanel.Dock="Left"
                        Content="모니터링"
                        IsChecked="{Binding IsMonitoring, Mode=TwoWay}" />
                    <Button
                        DockPanel.Dock="Right"
                        Command="{Binding DataContext.WriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource MaterialDesignOutlinedButton}">
                        <materialDesign:PackIcon Kind="ContentSave"/>
                    </Button>
                </DockPanel>
            </Grid>
        </materialDesign:Card>
    </DataTemplate>

    <!--  DataTemplateSelector 등록  -->
    <local:ParameterTemplateSelector
        x:Key="ParameterTemplateSelector"
        CardTemplate="{StaticResource CardTemplate}"
        ListTemplate="{StaticResource ListTemplate}" />

</ResourceDictionary>
